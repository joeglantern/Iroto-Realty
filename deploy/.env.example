# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Domains Caddy serves (and gets HTTPS certificates for).
# For the test run before cutover, use temporary subdomains such as new.irotorealty.com / admin-new.irotorealty.com.
SITE_DOMAIN=irotorealty.com
ADMIN_DOMAIN=admin.irotorealty.com

# Database. Generate the password with: openssl rand -hex 24  (hex keeps it URL-safe)
POSTGRES_USER=iroto
POSTGRES_DB=iroto
POSTGRES_PASSWORD=

# Admin login sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Contact form emails (copy the existing key from the Vercel website project settings)
RESEND_API_KEY=
