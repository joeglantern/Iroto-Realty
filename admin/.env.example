# Postgres connection (server-side only)
DATABASE_URL=postgres://iroto:your_password@localhost:5432/iroto

# Better Auth: generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Where uploaded images are stored on disk, and their public base URL
UPLOAD_DIR=./uploads
NEXT_PUBLIC_MEDIA_URL=http://localhost:3001/media
