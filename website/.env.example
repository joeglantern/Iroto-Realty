# Postgres connection (server-side only, never exposed to the browser)
DATABASE_URL=postgres://iroto:your_password@localhost:5432/iroto

# Public address of this site. Search engines are only allowed to index https://irotorealty.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public base URL for uploaded images ({bucket}/{path} is appended)
NEXT_PUBLIC_MEDIA_URL=http://localhost:3001/media

# Optional: contact form emails
RESEND_API_KEY=
